# Copy this file to .env.local and fill in real values for local dev.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# ── Claude API ──
ANTHROPIC_API_KEY=sk-ant-...

# ── DocuSign (Demo / Sandbox) ──
DOCUSIGN_INTEGRATION_KEY=efceafe8-89e8-4d2c-8f9e-fbea2af4a821
DOCUSIGN_SECRET_KEY=749e14d5-b86d-4a59-8835-12da4e58b8a0
DOCUSIGN_ACCOUNT_ID=880343cb-691b-499f-94f6-7ab43ec41402
DOCUSIGN_USER_ID=3047535f-eb78-4e74-8420-317147c3e0e2
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi/v2.1
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_TEMPLATE_ID=7df819db-3e87-4215-9d85-8aaae6bf9a2b

# RSA private key for JWT Grant. Generate this in DocuSign Admin → Apps and Keys
# → your integration → RSA Keypairs → Generate.
# Paste the FULL key including BEGIN/END lines. In Vercel, paste as-is into the
# env var input. In .env.local, escape newlines as \n and wrap in double quotes:
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...your-key-here...\n-----END RSA PRIVATE KEY-----"

# ── Agent (signs second, counter-signs the listing agreement) ──
AGENT_NAME=Ian Tudor
AGENT_EMAIL=ian.b.tudor@gmail.com
